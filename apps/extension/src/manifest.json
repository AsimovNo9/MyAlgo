{
  "manifest_version": 3,
  "name": "Personal Algorithm",
  "version": "0.1.0",
  "description": "Local, user-controlled scoring and feed controls for YouTube with inspectable Personal Algorithm evidence.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "action": {
    "default_title": "Personal Algorithm",
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/diagnostic-service-worker.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "src/content-scripts/youtube.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
