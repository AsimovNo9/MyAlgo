{
  "manifest_version": 3,
  "name": "Personal Algorithm",
  "version": "0.1.0",
  "description": "Weighted topic preferences and always/never rules for your YouTube feed.",
  "permissions": ["storage", "scripting", "identity"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://my-algo-web.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_title": "Personal Algorithm",
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content-scripts/youtube.ts"],
      "run_at": "document_idle"
    }
  ]
}
